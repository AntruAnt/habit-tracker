{
  "name": "habit-tracker",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @habit-tracker/mobile --",
    "dev:api": "npm run dev -w @habit-tracker/api",
